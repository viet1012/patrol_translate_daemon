# ===========================
# SQL Server
# ===========================
DB_DRIVER={ODBC Driver 17 for SQL Server}

DB_SERVER=192.168.122.2
DB_DATABASE=F2Database

DB_USER=kproduct
DB_PASSWORD=Tanphat@02032013

DB_TRUSTED_CONNECTION=no

# ===========================
# LLM
# ===========================
LM_URL=http://192.168.122.16:1234
LM_MODEL=openai/gpt-oss-20b
# Reload the model if a successful completion has no choices[0].message.content.
LM_STUDIO_AUTO_RELOAD=1
LM_STUDIO_RELOAD_COOLDOWN_SECONDS=60
LM_STUDIO_RELOAD_UNLOAD_FIRST=1
# Usually this is the same as LM_MODEL. Set a custom value only when LM Studio
# reports a different loaded model instance_id.
LM_STUDIO_INSTANCE_ID=openai/gpt-oss-20b
LM_STUDIO_FAILURE_THRESHOLD=3
LM_STUDIO_RELOAD_LOCK_FILE=./lm_studio_reload.lock
# Standalone monitor: sends a small probe even when translation is not running.
LM_STUDIO_MONITOR_ENABLED=1
LM_STUDIO_MONITOR_INTERVAL_SECONDS=30
LM_STUDIO_MONITOR_TIMEOUT_SECONDS=30
# An invalid translation waits 5 minutes before retrying; later failures back
# off exponentially to a maximum one-hour wait.
LLM_FAILURE_RETRY_SECONDS=300
LLM_FAILURE_RETRY_MAX_SECONDS=3600
LM_API_KEY=

# ===========================
# Service
# ===========================
POLL_INTERVAL_SECONDS=5
BATCH_SIZE=10

TABLE_NAME=F2_Patrol_Report
ID_COLUMN=id
CREATED_COLUMN=createdAt
EDITED_COLUMN=edit_date
TRANSLATE_COLUMNS=comment:comment_jp,countermeasure:countermeasure_jp,comment_jp:comment,countermeasure_jp:countermeasure
AI_TRANSLATE_UPDATE_COLUMN=ai_translate_update_at

LOG_DIR=logs
LOG_FILE_NAME=patrol_translate.log

DRY_RUN=0
